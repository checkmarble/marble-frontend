{
  "name": "ego-graph",
  "version": "0.1.2",
  "description": "Radial ego-network layouts with branch folding, for React Flow and anything else",
  "keywords": [
    "graph",
    "layout",
    "react-flow",
    "xyflow",
    "ego-network",
    "radial",
    "dagre",
    "visualization"
  ],
  "license": "MIT",
  "author": {
    "name": "Checkmarble",
    "url": "https://checkmarble.com"
  },
  "maintainers": [
    {
      "name": "William Schlegel",
      "url": "https://github.com/william-schlegel"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checkmarble/marble-frontend.git",
    "directory": "packages/ego-graph"
  },
  "homepage": "https://github.com/checkmarble/marble-frontend/tree/main/packages/ego-graph#readme",
  "bugs": {
    "url": "https://github.com/checkmarble/marble-frontend/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./fold": {
      "types": "./dist/fold.d.mts",
      "import": "./dist/fold.mjs"
    },
    "./react-flow": {
      "types": "./dist/react-flow.d.mts",
      "import": "./dist/react-flow.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "fold": [
        "./dist/fold.d.mts"
      ],
      "react-flow": [
        "./dist/react-flow.d.mts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check-package": "publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "prepublishOnly": "bun run build",
    "unit-tests": "vitest run"
  },
  "peerDependencies": {
    "@dagrejs/dagre": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@dagrejs/dagre": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@dagrejs/dagre": "^3.0.0",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.8"
  }
}
